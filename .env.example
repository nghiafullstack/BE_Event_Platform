# Copy to .env and fill in real values. .env is gitignored — never commit it.

# MySQL (one container, one database per service — see infra/mysql/init)
DB_ROOT_PASSWORD=changeme_root
DB_USERNAME=app_user
DB_PASSWORD=changeme_app
DB_HOST=localhost
# host port 3307 — a native mysqld already listens on 3306 on this Mac
DB_PORT=3307

# Redis (identity-service session/cache)
# host port 6380 — 6379 on this Mac is already used by another project's redis
REDIS_URL=redis://localhost:6380

# RabbitMQ
# host ports 5673/15673 — 5672/15672 already used by another project's rabbitmq
RABBITMQ_USERNAME=app_user
RABBITMQ_PASSWORD=changeme_rabbit
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673

# JWT — same secret on every service (stateless validation), base64-encoded, 256-bit+
JWT_SECRET=replace_with_a_real_base64_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# identity-service bootstraps this SUPER_ADMIN on first run if it doesn't exist yet —
# change the password (or log in and rotate it) right after first use.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=changeme_superadmin_password

# Mail (notification-service) — rotate the app password that leaked from
# BE_Event_Platform's application.properties before reusing it here.
SMTP_USERNAME=changeme@gmail.com
SMTP_PASSWORD=changeme_app_password

# Firebase Cloud Messaging (notification-service)
FCM_CREDENTIALS_JSON=changeme_path_or_inline_json

# event-service -> other services, REST base URLs
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
CUSTOMER_SERVICE_URL=http://localhost:8084
